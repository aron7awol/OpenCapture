{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OpenCapture Android GitHub release feed",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "packageName", "versionName", "versionCode", "minSdk", "size", "sha256", "downloadUrl"],
  "properties": {
    "schemaVersion": {"const": 1},
    "packageName": {"const": "com.uniformitycomp.opencapture"},
    "versionName": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$", "maxLength": 80},
    "versionCode": {"type": "integer", "minimum": 1, "maximum": 2100000000},
    "minSdk": {"type": "integer", "minimum": 28, "maximum": 10000},
    "size": {"type": "integer", "minimum": 1, "maximum": 134217728},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "downloadUrl": {"type": "string", "pattern": "^https://github\\.com/aron7awol/OpenCapture/releases/download/android-v[0-9]+\\.[0-9]+\\.[0-9]+-b[0-9]+/OpenCapture-android\\.apk$"}
  }
}
