{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OpenCapture Request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocolVersion", "id", "format", "quality", "frameCount", "settleMilliseconds", "context"],
  "properties": {
    "protocolVersion": {"const": 1, "type": "integer"},
    "id": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
    "operation": {"enum": [null, "capture", "applyControls"]},
    "format": {"enum": ["bayerRaw", "appleProRaw", "jpeg"]},
    "quality": {"enum": ["speed", "quality"]},
    "frameCount": {"type": "integer", "minimum": 1, "maximum": 32},
    "exposureSeconds": {"type": ["number", "null"], "exclusiveMinimum": 0, "maximum": 30},
    "iso": {"type": ["number", "null"], "minimum": 1, "maximum": 204800},
    "focusPosition": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "streaming": {"type":"object","additionalProperties":false,"required":["mode"],"properties":{"mode":{"const":"originals-v1"}}},
    "averaging": {
      "type": "object", "additionalProperties": false, "required": ["mode", "emptyFramePolicy", "keepOriginals"],
      "properties": {
        "mode": {"enum": ["bayer-mean-v1", "bayer-mean-v2", "bayer-mean-v3"]},
        "emptyFramePolicy": {"enum": ["relative", "illuminated", "dark"]},
        "keepOriginals": {"type": "boolean"}
      }
    },
    "whiteBalance": {
      "type": ["object", "null"], "additionalProperties": false, "required": ["red", "green", "blue"],
      "properties": {"red": {"type": "number", "minimum": 1, "maximum": 64}, "green": {"type": "number", "minimum": 1, "maximum": 64}, "blue": {"type": "number", "minimum": 1, "maximum": 64}}
    },
    "settleMilliseconds": {"type": "integer", "minimum": 0, "maximum": 10000},
    "context": {"type": "object", "maxProperties": 16, "propertyNames": {"maxLength": 64}, "additionalProperties": {"type": "string", "maxLength": 256}}
  },
  "allOf": [
    {"if":{"required":["streaming"]},"then":{"not":{"required":["averaging"]},"properties":{"operation":{"enum":[null,"capture"]}}}},
    {"if": {"required": ["averaging"]}, "then": {"properties": {"format": {"const": "bayerRaw"}, "operation": {"enum": [null, "capture"]}}}},
    {"if": {"required": ["operation"], "properties": {"operation": {"const": "applyControls"}}}, "then": {"properties": {"frameCount": {"const": 1}}}},
    {"if": {"properties": {"format": {"const": "bayerRaw"}}}, "then": {"properties": {"quality": {"const": "speed"}}}},
    {"if": {"properties": {"format": {"const": "appleProRaw"}}}, "then": {"properties": {"quality": {"const": "quality"}}}},
    {"if": {"required": ["exposureSeconds"], "properties": {"exposureSeconds": {"type": "number"}}}, "then": {"required": ["iso"], "properties": {"iso": {"type": "number"}}}},
    {"if": {"required": ["iso"], "properties": {"iso": {"type": "number"}}}, "then": {"required": ["exposureSeconds"], "properties": {"exposureSeconds": {"type": "number"}}}}
  ]
}
